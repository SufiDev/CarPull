-- User table and queries
CREATE TABLE User (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

insertUser:
INSERT INTO User(id, name)
VALUES (?, ?);

selectUserById:
SELECT * FROM User
WHERE id = ?;

selectAllUsers:
SELECT * FROM User
ORDER BY name;

updateUser:
UPDATE User
SET name = ?
WHERE id = ?;

deleteUser:
DELETE FROM User
WHERE id = ?;

-- Trip table and queries
CREATE TABLE Trip (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    tripStart TEXT NOT NULL,
    tripEnd TEXT NOT NULL,
    tripDriverId INTEGER NOT NULL REFERENCES User(id),
    tripStatus TEXT NOT NULL
);

insertTrip:
INSERT INTO Trip(id, name, tripStart, tripEnd, tripDriverId, tripStatus)
VALUES (?, ?, ?, ?, ?, ?);

selectTripById:
SELECT * FROM Trip
WHERE id = ?;

selectAllTrips:
SELECT * FROM Trip
ORDER BY tripStart;

updateTrip:
UPDATE Trip
SET name = ?, tripStart = ?, tripEnd = ?, tripDriverId = ?, tripStatus = ?
WHERE id = ?;

deleteTrip:
DELETE FROM Trip
WHERE id = ?;

removeAllTrips:
DELETE FROM Trip;

-- Trip passenger table and queries
CREATE TABLE TripPassenger (
    tripId INTEGER NOT NULL REFERENCES Trip(id) ON DELETE CASCADE,
    userId INTEGER NOT NULL REFERENCES User(id) ON DELETE CASCADE,
    PRIMARY KEY (tripId, userId)
);

addTripPassenger:
INSERT OR IGNORE INTO TripPassenger(tripId, userId)
VALUES (?, ?);

removeTripPassenger:
DELETE FROM TripPassenger
WHERE tripId = ? AND userId = ?;

selectPassengersForTrip:
SELECT User.*
FROM User
INNER JOIN TripPassenger ON User.id = TripPassenger.userId
WHERE TripPassenger.tripId = ?
ORDER BY User.name;
